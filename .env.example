# Copy to .env and fill in your own credentials. Never commit .env.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=plp_indoe5_cs96_ov32
QDRANT_VECTOR_NAME=
PAYLOAD_TEXT_KEY=text
EMBEDDING_MODEL_NAME=LazarusNLP/all-indo-e5-small-v4
